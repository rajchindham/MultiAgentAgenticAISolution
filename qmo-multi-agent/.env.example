QMO_MODE=demo
OPENAI_API_KEY=
QMO_MODEL=gpt-4.1-mini
QMO_EMBED_MODEL=text-embedding-3-small
QMO_DB_PATH=./qmo.db
# API requires a configured token even in demo mode; replace before serving.
QMO_API_TOKEN=
QMO_ALLOWED_APPLICATIONS=Mobile App,Web Check-in
QMO_ALLOWED_PORTFOLIO=Digital Platforms

QMO_DATA_BACKEND=sample
# enterprise requires optional requirements-enterprise.txt and view/schema mapping
QMO_SQLSERVER_DSN=
QMO_POSTGRES_DSN=
QMO_MIN_SIMILARITY=0.35
